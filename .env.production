# ==============================================================================
# NETFLIX CLONE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Save this file as '.env' in your deployment environment or inject these 
# variables directly into AWS Secrets Manager / EKS Kubernetes Secrets.

# ------------------------------------------------------------------------------
# 1. Global Ports & General Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PROJECT_NAME=netflix-clone

# ------------------------------------------------------------------------------
# 2. Database Connections (PostgreSQL Aurora & Redis ElastiCache)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# Replace '<aurora-cluster-endpoint>' with your AWS Aurora Global Database Writer endpoint
DATABASE_URL=postgresql://netflix_admin:Password123!@<aurora-cluster-endpoint>.cluster-custom-xxxxx.us-east-1.rds.amazonaws.com:5432/netflix_db
DB_SSL=true

# ElastiCache Redis Endpoint
# Replace '<elasticache-redis-endpoint>' with your Redis primary cluster endpoint
REDIS_URL=redis://<elasticache-redis-endpoint>.xxxxx.use1.cache.amazonaws.com:6379

# ------------------------------------------------------------------------------
# 3. Event Streaming & Search Coordinate Layers (MSK Kafka & AWS OpenSearch)
# ------------------------------------------------------------------------------
# MSK Kafka Bootstrap Brokers (Comma-separated)
# Replace with your MSK Broker endpoints (port 9092 for plaintext, 9094 for TLS)
KAFKA_BROKERS=b-1.msk-cluster.xxxxx.c3.kafka.us-east-1.amazonaws.com:9092,b-2.msk-cluster.xxxxx.c3.kafka.us-east-1.amazonaws.com:9092
KAFKA_CLIENT_ID=netflix-services-production

# AWS Managed OpenSearch Domain Endpoint
# Replace with your OpenSearch Domain Endpoint URL
OPENSEARCH_URL=https://search-netflix-opensearch-xxxxx.us-east-1.es.amazonaws.com

# ------------------------------------------------------------------------------
# 4. Security Keys & Tokens (JWT Secrets)
# ------------------------------------------------------------------------------
# Replace with high-entropy cryptographic strings in production
JWT_SECRET=prod-access-token-jwt-secret-key-high-entropy-998877!
REFRESH_SECRET=prod-refresh-token-jwt-secret-key-high-entropy-112233!

# ------------------------------------------------------------------------------
# 5. CDN Secure Video Playback Signing (S3 & Amazon CloudFront)
# ------------------------------------------------------------------------------
# CloudFront Distribution Custom CNAME or Domain Name (fronting S3 video bucket)
CLOUDFRONT_DOMAIN=cdn.netflixclone.prod

# CloudFront Public Key Pair ID registered in AWS Console
CLOUDFRONT_KEY_PAIR_ID=K3A1A2A3A4A5A6

# CloudFront Private Key (Private key PEM file contents, with newline escapes '\n')
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0y...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 6. Service-to-Service Internal Communication Ports (Kubernetes ClusterIPs)
# ------------------------------------------------------------------------------
# Used inside the cluster by EKS containers to reach each other internally.
# In local compose, these resolve to container names. In EKS, they resolve to cluster services.
CATALOG_SERVICE_URL=http://catalog-service:5002
USER_SERVICE_URL=http://user-service:5004
METADATA_SERVICE_URL=http://metadata-service:5005
RECOMMENDATION_SERVICE_URL=http://recommendation-service:5006
SEARCH_SERVICE_URL=http://search-service:5007
BILLING_SERVICE_URL=http://billing-service:5008
NOTIFICATION_SERVICE_URL=http://notification-service:5009
